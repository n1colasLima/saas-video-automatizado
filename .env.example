# ============================================================================
# Tomada · .env.example
# Copie para .env.local (Next) e .env (worker) e preencha as variáveis abaixo.
# ============================================================================

# ----------------------------------------------------------------------------
# Google Gemini
# ----------------------------------------------------------------------------
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos. Defaults usam Flash (free tier real); Pro só roda com billing ativo.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Voz padrão do Gemini TTS. Opções: Kore, Puck, Charon, Fenrir, Aoede
GEMINI_TTS_VOICE=Kore

# ----------------------------------------------------------------------------
# Firebase (web app SDK) — apenas Firestore (fila de jobs)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# Firebase Admin SDK (Firestore server-side)
# ----------------------------------------------------------------------------
# Console Firebase → Project Settings → Service Accounts → "Generate new private key"
# Salve como serviceAccountKey.json na raiz do projeto.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
# Alternativa em vez do path:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ----------------------------------------------------------------------------
# Worker local
# ----------------------------------------------------------------------------
# Intervalo de polling do worker (ms)
WORKER_POLL_INTERVAL_MS=2000

# Diretório para cache local de imagens/áudios intermediários
WORKER_CACHE_DIR=./cache

# Caminho do FFmpeg (deixe vazio para usar PATH do sistema)
FFMPEG_PATH=

# ----------------------------------------------------------------------------
# Pollinations.ai (fallback grátis de imagens, sem chave)
# ----------------------------------------------------------------------------
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
