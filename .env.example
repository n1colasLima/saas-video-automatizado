# Copie este arquivo para .env e preencha com suas chaves
# Todas estas APIs têm tier gratuito

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (para legendas via Whisper) - https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: voz do Edge-TTS em PT-BR (padrão = Antonio)
# Outras opções: pt-BR-FranciscaNeural, pt-BR-ThalitaNeural
TTS_VOICE=pt-BR-AntonioNeural
